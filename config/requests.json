{
  "anthropicMessages": {
    "schema": {
      "method": "POST",
      "host": "api.anthropic.com",
      "path": "/v1/messages",
      "headers": {
        "x-api-key": "<%= iparam.anthropic_api_key %>",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      }
    },
    "options": {
      "maxAttempts": 2,
      "retryDelay": 1000
    }
  },
  "fdGetTicket": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/tickets/<%= context.ticket_id %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>"
      }
    }
  },
  "fdGetConversations": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/tickets/<%= context.ticket_id %>/conversations",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>"
      }
    }
  },
  "fdGetArticle": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/solutions/articles/<%= context.article_id %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>"
      }
    }
  },
  "fdCreateArticle": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/solutions/folders/<%= context.folder_id %>/articles",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>",
        "content-type": "application/json"
      }
    }
  },
  "fdUpdateArticle": {
    "schema": {
      "method": "PUT",
      "host": "<%= iparam.freshdesk_domain %>",
      "path": "/api/v2/solutions/articles/<%= context.article_id %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshdesk_api_key + ':X') %>",
        "content-type": "application/json"
      }
    }
  },
  "vobizMakeCall": {
    "schema": {
      "method": "POST",
      "host": "api.vobiz.ai",
      "path": "/api/v1/Account/<%= context.auth_id %>/Call/",
      "headers": {
        "X-Auth-ID": "<%= iparam.vobiz_auth_id %>",
        "X-Auth-Token": "<%= iparam.vobiz_auth_token %>",
        "content-type": "application/json"
      }
    },
    "options": {
      "maxAttempts": 1
    }
  },
  "voyageEmbeddings": {
    "schema": {
      "method": "POST",
      "host": "api.voyageai.com",
      "path": "/v1/embeddings",
      "headers": {
        "Authorization": "Bearer <%= iparam.voyage_api_key %>",
        "content-type": "application/json"
      }
    },
    "options": {
      "maxAttempts": 2,
      "retryDelay": 1000
    }
  }
}
